# Fallback de segurança para qualquer URL histórica não inventariada
RewriteCond %{QUERY_STRING} ^dt= [NC]
RewriteRule ^posts/?$ /blog [R=301,L,QSD]

# Arquivos/diretórios reais do novo build
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Páginas pré-renderizadas: /sobre -> /sobre.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Fallback React Router
RewriteRule ^ index.html [L]
